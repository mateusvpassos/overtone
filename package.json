{
  "name": "overtone",
  "version": "0.9.1",
  "description": "Overtone — sons, pads, loops e knobs para teclado MIDI sem abrir DAW",
  "main": "main.js",
  "private": true,
  "author": "Mateus Vinícius dos Passos",
  "license": "MIT",
  "homepage": "https://github.com/mateusvpassos/overtone",
  "repository": {
    "type": "git",
    "url": "https://github.com/mateusvpassos/overtone.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir",
    "test": "node --test exporter.test.js"
  },
  "build": {
    "appId": "com.mateusvpassos.overtone",
    "productName": "Overtone",
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "renderer/samples/**",
      "node_modules/lamejs/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "exporter.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overtone",
      "artifactName": "Overtone-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "lamejs": "^1.2.1"
  }
}
