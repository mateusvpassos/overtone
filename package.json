{
  "name": "overtone",
  "version": "0.5.0",
  "description": "Overtone — sons, pads e knobs pro teclado MIDI sem abrir DAW (Electron)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.mateusvpassos.overtone",
    "productName": "Overtone",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "exporter.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overtone",
      "artifactName": "Overtone-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "lamejs": "^1.2.1"
  }
}
